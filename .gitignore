# Build artifacts
build/
build-*/

# Local .uf2 builds, kept out of the repo. A RELEASED binary lives in UF2/
# and is committed; this directory is just the one you drag onto the Pico.
FLASHME/*.uf2

# Editor / OS noise
.vscode/
*.swp
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Rendered reference audio from the tools, if any is ever generated.
tools/*.wav

# Bisection builds from bench debugging. Useful while chasing a fault,
# never part of a release - each one deliberately breaks something.
DIAGNOSTIC/
